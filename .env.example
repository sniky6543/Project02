# ==========================================
# [Team 1] Frontend Environment Variables
# ==========================================
VITE_API_BASE_URL=http://localhost:8000/api
VITE_ENV=development

# ==========================================
# [Team 2] Backend Server Configuration
# ==========================================
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# [Team 3] Database Connection (PostgreSQL / Supabase)
# ==========================================
# 예시: postgresql+asyncpg://user:password@localhost:5432/youth_compass
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/youth_compass
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# ==========================================
# [Team 4] LLM AI Engine API Keys
# ==========================================
# 1. OpenAI
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# 2. OpenRouter (다중 LLM 라우팅)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# 3. Ollama (로컬 또는 원격 호스트)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ==========================================
# Notification Services (Telegram & Email)
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ==========================================
# [Data Crawling & Batch] 청년 정책 데이터 수집 API
# ==========================================
# 1. 온통청년 OpenAPI 인증키
# 발급처: https://www.youthcenter.go.kr/cmnFooter/openapiIntro/oaiGuide
ONTONG_API_KEY=your_ontong_api_key_here

# 2. 공공데이터포털 일반 인증키 (Decoding 또는 Encoding 키)
# 발급처: https://www.data.go.kr/ (한국사회보장정보원_지자체복지서비스 / 한국사회보장정보원_중앙부처복지서비스)
DATA_API_KEY=your_public_data_api_key_here
